UITD "Prueba fallas HTML (valido)" {

UI 1 "Contenedor A" actions {
  clicks "openA";
}

UI 2 "Contenedor B" actions {
  clicks "openB";
}

UI 3 "Panel Comun" actions {
  clicks "go";
  clicks "next";
}

UI 4 "Hermano Perdido" actions {
  clicks "ping";
}

UI 5 "Destino A" actions {
  clicks "backA";
}

UI 6 "Destino B" actions {
  clicks "backB";
}

UI 7 "Contenedor C" actions {
  clicks "jump";
}

UI 8 "Destino C" actions {
  clicks "ok";
}

FRAGMENT "CasoHermanoYCondicion" {
  DRAW { 1(3,4,5,6), 2(3) };

  TRANSITION from 1(3) to 1(5) if user clicks "go";

  TRANSITION from 1(3) to 1(5) if user clicks "next";
  TRANSITION from 1(3) to 1(6) if user clicks "next" AND "premium";

  TRANSITION from 4 to 4 if user clicks "ping";
  TRANSITION from 5 to 5 if user clicks "backA";
  TRANSITION from 6 to 6 if user clicks "backB";
}

FRAGMENT "CasoCruceFragmentos" {
  DRAW { 7(3), 8, 1, 2 };

  TRANSITION from 7(3) to 8 if user clicks "go";
  TRANSITION from 7 to 7 if user clicks "jump";
  TRANSITION from 8 to 8 if user clicks "ok";
  TRANSITION from 1 to 1 if user clicks "openA";
  TRANSITION from 2 to 2 if user clicks "openB";
}

}
